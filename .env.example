# Server
PORT=4000
NODE_ENV=development

# Neon PostgreSQL
# DATABASE_URL  -> the *pooled* connection string (host contains "-pooler")
# DIRECT_URL    -> the *direct* connection string (used by prisma migrate)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/mbm?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/mbm?sslmode=require"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Root admin account — created on server start if it doesn't exist yet.
# Change the password after first login (My account page).
ADMIN_EMAIL="admin@mbm.app"
ADMIN_PASSWORD="change-me-admin-password"
ADMIN_NAME="Administrator"
ADMIN_USERNAME="admin"

# Frontend URL used in email links (verify email, reset password)
APP_URL="http://localhost:5173"

# ----- Email (verification codes, password reset, forgot username) -----
# Brevo (https://brevo.com, free 300/day) is used when BREVO_API_KEY is set; otherwise Resend; otherwise
# emails are printed to the console. EMAIL_FROM must be a sender you verified in the provider.
# Brevo without a domain: Senders, domains & dedicated IPs -> Senders -> add + verify e.g. your Gmail.
BREVO_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="Budget Manager <you@gmail.com>"

# ----- SMS (phone sign-up / recovery) via Twilio -----
# TWILIO_FROM = your Twilio phone number (+1...) or a Messaging Service SID (MG...).
# Trial accounts can only text numbers verified in the Twilio console.
# Without these, SMS are printed to the console in development and refused in production.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Country for phone numbers typed without +code (012 345 678 -> +85512345678)
DEFAULT_PHONE_COUNTRY="KH"

# Optional: key for encrypting authenticator-app secrets (defaults to JWT_SECRET).
# Set it if you might rotate JWT_SECRET, otherwise authenticator MFA must be set up again.
MFA_ENCRYPTION_KEY=""

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173,https://mbm-app-v1.vercel.app"
