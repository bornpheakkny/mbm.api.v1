# Server
PORT=4000
NODE_ENV=development

# Neon PostgreSQL
# DATABASE_URL  -> the *pooled* connection string (host contains "-pooler")
# DIRECT_URL    -> the *direct* connection string (used by prisma migrate)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/mbm?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/mbm?sslmode=require"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173,https://mbm-app-v1.vercel.app"
