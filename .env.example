# Server
PORT=4000
NODE_ENV=development

# Neon PostgreSQL
# DATABASE_URL  -> the *pooled* connection string (host contains "-pooler")
# DIRECT_URL    -> the *direct* connection string (used by prisma migrate)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/mbm?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/mbm?sslmode=require"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Root admin account — created on server start if it doesn't exist yet.
# Change the password after first login (My account page).
ADMIN_EMAIL="admin@mbm.app"
ADMIN_PASSWORD="change-me-admin-password"
ADMIN_NAME="Administrator"

# Frontend URL used in email links (verify email, reset password)
APP_URL="http://localhost:5173"

# Email via Resend (https://resend.com). Leave RESEND_API_KEY empty to print emails to the console.
# onboarding@resend.dev can only send to your own Resend account email; verify a domain to send to anyone.
RESEND_API_KEY=""
EMAIL_FROM="Budget Manager <onboarding@resend.dev>"

# Optional: key for encrypting authenticator-app secrets (defaults to JWT_SECRET).
# Set it if you might rotate JWT_SECRET, otherwise authenticator MFA must be set up again.
MFA_ENCRYPTION_KEY=""

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173,https://mbm-app-v1.vercel.app"
