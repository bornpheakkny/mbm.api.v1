// Monthly Budget Management System — data model
// Mirrors the Budget / Income / Expenses sheets:
//   Category  -> income sources & expense categories
//   Budget    -> budgeted amount per category per month ("YYYY-MM")
//   Transaction -> actual income / expense entries

// Prisma 7: connection URLs live in prisma.config.ts (migrations) and
// src/lib/prisma.ts (runtime, via @prisma/adapter-pg).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum MfaMethod {
  TOTP
  EMAIL
}

enum AuthTokenType {
  EMAIL_VERIFY
  EMAIL_CHANGE
  PASSWORD_RESET
  MFA_CHALLENGE
  MFA_EMAIL_SETUP
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String
  passwordHash      String
  currency          String         @default("USD")
  role              Role           @default(USER)
  active            Boolean        @default(true)
  lastLoginAt       DateTime?
  emailVerifiedAt   DateTime?
  /// New address waiting for confirmation (Change email)
  pendingEmail      String?
  /// Display settings (bar colors, badge style); see src/lib/preferences.ts
  preferences       Json           @default("{}")
  /// Bumped on password change/reset to invalidate existing sessions
  tokenVersion      Int            @default(0)
  /// null = two-step verification off
  mfaMethod         MfaMethod?
  /// AES-GCM encrypted TOTP secret (active / being set up)
  totpSecret        String?
  totpPendingSecret String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  categories        Category[]
  budgets           Budget[]
  transactions      Transaction[]
  authTokens        AuthToken[]
  recoveryCodes     RecoveryCode[]
}

/// One-time links and codes: email verification, password reset, MFA login challenges
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  /// sha256 of the token sent in a link / returned to the client
  tokenHash String        @unique
  /// sha256 of a 6-digit code sent by email (MFA)
  codeHash  String?
  attempts  Int           @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// One-time backup codes for two-step verification
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         CategoryType
  color        String        @default("gray")
  sortOrder    Int           @default(0)
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets      Budget[]
  transactions Transaction[]

  @@unique([userId, type, name])
  @@index([userId, type])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      String // "YYYY-MM"
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([userId, month])
}

model Transaction {
  id          String       @id @default(cuid())
  userId      String
  categoryId  String
  type        CategoryType
  date        DateTime     @db.Date
  description String
  amount      Decimal      @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, type, date])
}
