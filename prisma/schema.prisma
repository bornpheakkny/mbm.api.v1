// Monthly Budget Management System — data model
// Mirrors the Budget / Income / Expenses sheets:
//   Category  -> income sources & expense categories
//   Budget    -> budgeted amount per category per month ("YYYY-MM")
//   Transaction -> actual income / expense entries

// Prisma 7: connection URLs live in prisma.config.ts (migrations) and
// src/lib/prisma.ts (runtime, via @prisma/adapter-pg).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  currency     String        @default("USD")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categories   Category[]
  budgets      Budget[]
  transactions Transaction[]
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         CategoryType
  color        String        @default("gray")
  sortOrder    Int           @default(0)
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets      Budget[]
  transactions Transaction[]

  @@unique([userId, type, name])
  @@index([userId, type])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      String // "YYYY-MM"
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([userId, month])
}

model Transaction {
  id          String       @id @default(cuid())
  userId      String
  categoryId  String
  type        CategoryType
  date        DateTime     @db.Date
  description String
  amount      Decimal      @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, type, date])
}
